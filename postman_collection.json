            { "name": "Loan Products - list all loan products by partnerId and currency", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/loan-products?partnerId={{partner_id}}&currency={{currency}}" } },
            { "name": "Loan Products - list all loan products by partnerId currency and isActive", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/loan-products?partnerId={{partner_id}}&currency={{currency}}&isActive=true" } },
