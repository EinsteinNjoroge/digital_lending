{
  "info": {
    "_postman_id": "2e5c96d4-8ad8-4b2d-b57f-2a37f1c4c001",
    "name": "Digital Lending Platform API",
    "description": "Postman collection for the lending-platform submission. It includes a happy-path borrower journey, a credit-denied journey, and a full endpoint catalog for all modules.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const runId = pm.collectionVariables.get('run_id') || String(Date.now());",
          "pm.collectionVariables.set('run_id', runId);",
          "const defaults = {",
          "  baseUrl: 'http://localhost:8080',",
          "  actor_email: 'postman.runner@lending.local',",
          "  partner_id: 'SAF_KE_01',",
          "  currency: 'KES',",
          "  seeded_loan_product_id: 'prod_001',",
          "  disbursement_provider: 'INTERNAL',",
          "  repayment_provider: 'MPESA',",
          "  happy_request_amount: '5000.00',",
          "  denied_request_amount: '5000.00',",
          "  from_date: '2026-01-01T00:00:00',",
          "  to_date: '2026-12-31T23:59:59'",
          "};",
          "Object.entries(defaults).forEach(([key, value]) => { if (!pm.collectionVariables.get(key)) pm.collectionVariables.set(key, value); });",
          "const generated = {",
          "  happy_profile_email: 'happy.' + runId + '@example.com',",
          "  denied_profile_email: 'denied.' + runId + '@example.com',",
          "  all_profile_email: 'catalog.' + runId + '@example.com',",
          "  happy_identity_number: 'HAPPY' + runId,",
          "  denied_identity_number: 'DENIED' + runId,",
          "  all_identity_number: 'CATALOG' + runId,",
          "  family_code: 'FAM_API_' + runId,",
          "  product_code: 'LP_API_' + runId,",
          "  category_id: 'FEE_' + runId,",
          "  happy_loan_idempotency_key: 'happy-loan-' + runId,",
          "  denied_loan_idempotency_key: 'denied-loan-' + runId,",
          "  all_loan_idempotency_key: 'all-loan-' + runId",
          "};",
          "Object.entries(generated).forEach(([key, value]) => { if (!pm.collectionVariables.get(key)) pm.collectionVariables.set(key, value); });",
          "pm.collectionVariables.set('callback_timestamp', new Date().toISOString().slice(0, 19));"
        ]
      }
    }
  ],
