  "item": [
    {
      "name": "Happy-path user-loan journey flow",
      "item": [
        {
          "name": "Profiles - create happy path borrower",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Profile created', function () { pm.response.to.have.status(201); });",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('happy_profile_id', json.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"profileType\": \"INDIVIDUAL\",\n  \"email\": \"{{happy_profile_email}}\",\n  \"phoneCountryCode\": \"+254\",\n  \"phoneNationalNumber\": \"712345678\",\n  \"residenceCountry\": \"KEN\",\n  \"firstName\": \"Alex\",\n  \"lastName\": \"Happy{{run_id}}\",\n  \"dateOfBirth\": \"1996-06-07\",\n  \"identities\": [\n    {\n      \"documentType\": \"NATIONAL_ID\",\n      \"documentNumber\": \"{{happy_identity_number}}\"\n    }\n  ]\n}"
            },
            "url": "{{baseUrl}}/api/v1/profiles"
          }
        },
        {
          "name": "Accounts - create happy path loan application",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Loan application created', function () { pm.response.to.have.status(201); });",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('happy_loan_account_id', json.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Modified-By", "value": "{{actor_email}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"profileId\": \"{{happy_profile_id}}\",\n  \"loanProductId\": \"{{seeded_loan_product_id}}\",\n  \"idempotencyKey\": \"{{happy_loan_idempotency_key}}\",\n  \"initialPrincipal\": {{happy_request_amount}},\n  \"partnerId\": \"{{partner_id}}\",\n  \"currency\": \"{{currency}}\",\n  \"scoringFeatures\": {\n    \"wallet_throughput_30d\": \"30000\",\n    \"has_active_default\": \"false\"\n  },\n  \"disbursementProviderId\": \"{{disbursement_provider}}\",\n  \"disbursementDestinationReference\": \"WALLET-{{happy_profile_id}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/loan-accounts"
          }
        },
        {
          "name": "Accounts - list happy path loan accounts by profileId",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Loan accounts fetched', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "if (json.content && json.content.length > 0) {",
                  "  pm.collectionVariables.set('happy_loan_account_id', json.content[0].id);",
                  "  if (json.content[0].accountNumber) pm.collectionVariables.set('happy_account_number', json.content[0].accountNumber);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/loan-accounts?profileId={{happy_profile_id}}"
          }
        },
        {
          "name": "Payments - list happy path payments by profileId",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Payments fetched', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "if (json.content && json.content.length > 0) {",
                  "  const disbursement = json.content.find(item => item.category === 'DISBURSEMENT');",
                  "  if (disbursement) {",
                  "    pm.collectionVariables.set('happy_disbursement_tx_id', disbursement.id);",
                  "    if (disbursement.externalReferenceNumber) pm.collectionVariables.set('happy_disbursement_external_ref', disbursement.externalReferenceNumber);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/payments?profileId={{happy_profile_id}}"
          }
        },
        {
          "name": "Payments - complete happy path disbursement callback",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"internalTransactionId\": \"{{happy_disbursement_tx_id}}\",\n  \"providerTransactionId\": \"INTERNAL-TX-{{run_id}}\",\n  \"externalReferenceNumber\": \"{{happy_disbursement_external_ref}}\",\n  \"outcomeStatus\": \"COMPLETED\",\n  \"accountReference\": \"{{happy_account_number}}\",\n  \"profileId\": \"{{happy_profile_id}}\",\n  \"categoryId\": \"DISBURSEMENT\",\n  \"amount\": {{happy_request_amount}},\n  \"currency\": \"{{currency}}\",\n  \"rawPayload\": \"{\\\"provider\\\":\\\"INTERNAL\\\",\\\"status\\\":\\\"COMPLETED\\\"}\",\n  \"callbackTimestamp\": \"{{callback_timestamp}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/payments/providers/{{disbursement_provider}}/callback"
          }
        },
        {
          "name": "Payments - create happy path repayment",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idempotencyKey\": \"repayment-{{run_id}}\",\n  \"categoryId\": \"REPAYMENT\",\n  \"providerId\": \"{{repayment_provider}}\",\n  \"accountReference\": \"{{happy_account_number}}\",\n  \"loanAccountId\": \"{{happy_loan_account_id}}\",\n  \"profileId\": \"{{happy_profile_id}}\",\n  \"senderPartyReference\": \"{{happy_profile_id}}\",\n  \"receiverPartyReference\": \"LENDER_TREASURY\",\n  \"amount\": {{happy_request_amount}},\n  \"currency\": \"{{currency}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/payments"
          }
        },
        {
          "name": "Accounts - list happy path loan accounts after repayment",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/loan-accounts?profileId={{happy_profile_id}}"
          }
        },
        {
          "name": "Notifications - list happy path notification logs by recipient",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/notifications?recipient={{happy_profile_email}}"
          }
        }
      ]
    },
