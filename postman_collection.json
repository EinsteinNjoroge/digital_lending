    },
    {
      "name": "All endpoints in all modules",
      "item": [
        {
          "name": "Profile module",
          "item": [
            {
              "name": "Profiles - create profile",
              "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const json = pm.response.json(); if (json.id) pm.collectionVariables.set('all_profile_id', json.id);"] } }],
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": { "mode": "raw", "raw": "{\n  \"profileType\": \"INDIVIDUAL\",\n  \"email\": \"{{all_profile_email}}\",\n  \"phoneCountryCode\": \"+254\",\n  \"phoneNationalNumber\": \"755555555\",\n  \"residenceCountry\": \"KEN\",\n  \"firstName\": \"Casey\",\n  \"lastName\": \"Catalog{{run_id}}\",\n  \"dateOfBirth\": \"1992-01-02\",\n  \"identities\": [\n    {\n      \"documentType\": \"NATIONAL_ID\",\n      \"documentNumber\": \"{{all_identity_number}}\"\n    }\n  ]\n}" },
                "url": "{{baseUrl}}/api/v1/profiles"
              }
            },
            { "name": "Profiles - get profile by id", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/profiles/{{all_profile_id}}" } },
            { "name": "Profiles - list all profiles", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/profiles" } },
            {
              "name": "Profiles - update profile",
              "request": {
                "method": "PUT",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": { "mode": "raw", "raw": "{\n  \"email\": \"updated.{{all_profile_email}}\",\n  \"phoneCountryCode\": \"+254\",\n  \"phoneNationalNumber\": \"766666666\",\n  \"residenceCountry\": \"KEN\"\n}" },
                "url": "{{baseUrl}}/api/v1/profiles/{{all_profile_id}}"
              }
            },
