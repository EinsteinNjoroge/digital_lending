                "body": { "mode": "raw", "raw": "{\n  \"profileId\": \"{{all_profile_id}}\",\n  \"loanProductId\": \"{{seeded_loan_product_id}}\",\n  \"idempotencyKey\": \"{{all_loan_idempotency_key}}\",\n  \"initialPrincipal\": 4000.00,\n  \"partnerId\": \"{{partner_id}}\",\n  \"currency\": \"{{currency}}\",\n  \"scoringFeatures\": {\n    \"wallet_throughput_30d\": \"28000\",\n    \"has_active_default\": \"false\"\n  },\n  \"disbursementProviderId\": \"{{disbursement_provider}}\",\n  \"disbursementDestinationReference\": \"WALLET-{{all_profile_id}}\"\n}" },
                "url": "{{baseUrl}}/api/v1/loan-accounts"
