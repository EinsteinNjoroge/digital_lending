            { "name": "Loan Products - delete loan product", "request": { "method": "DELETE", "header": [{ "key": "X-Modified-By", "value": "{{actor_email}}" }], "url": "{{baseUrl}}/api/v1/loan-products/{{product_id}}" } }
          ]
        },
        {
          "name": "Credit scoring module",
          "item": [
            {
              "name": "Credit Scoring - create model",
              "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const json = pm.response.json(); if (json.id) pm.collectionVariables.set('scoring_model_id', json.id);"] } }],
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": { "mode": "raw", "raw": "{\n  \"partnerId\": \"{{partner_id}}\",\n  \"currency\": \"{{currency}}\",\n  \"loanProductId\": \"{{product_id}}\",\n  \"rulesPayload\": {\n    \"knockOutRules\": [\n      { \"feature\": \"has_active_default\", \"operator\": \"EQUALS\", \"value\": \"true\" }\n    ],\n    \"scoringWeights\": [\n      {\n        \"feature\": \"wallet_throughput_30d\",\n        \"ranges\": [\n          { \"min\": 0, \"max\": 9999.99, \"points\": 150 },\n          { \"min\": 10000, \"max\": 19999.99, \"points\": 250 },\n          { \"min\": 20000, \"max\": 999999999, \"points\": 400 }\n        ]\n      }\n    ],\n    \"decisionThresholds\": { \"minimumScoreRequired\": 200, \"baseMultiplier\": 0.5 }\n  }\n}" },
                "url": "{{baseUrl}}/api/v1/credit-scoring/models"
              }
            },
            { "name": "Credit Scoring - get model by id", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/credit-scoring/models/{{scoring_model_id}}" } },
            { "name": "Credit Scoring - list all models", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/credit-scoring/models" } },
            { "name": "Credit Scoring - list all models by partnerId", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/credit-scoring/models?partnerId={{partner_id}}" } },
            { "name": "Credit Scoring - list all models by isActive", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/credit-scoring/models?isActive=true" } },
            { "name": "Credit Scoring - list all models by partnerId and isActive", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/credit-scoring/models?partnerId={{partner_id}}&isActive=true" } },
            {
              "name": "Credit Scoring - update model",
              "request": {
                "method": "PUT",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": { "mode": "raw", "raw": "{\n  \"partnerId\": \"{{partner_id}}\",\n  \"currency\": \"{{currency}}\",\n  \"loanProductId\": \"{{product_id}}\",\n  \"rulesPayload\": {\n    \"knockOutRules\": [\n      { \"feature\": \"has_active_default\", \"operator\": \"EQUALS\", \"value\": \"true\" }\n    ],\n    \"scoringWeights\": [\n      {\n        \"feature\": \"wallet_throughput_30d\",\n        \"ranges\": [\n          { \"min\": 0, \"max\": 9999.99, \"points\": 120 },\n          { \"min\": 10000, \"max\": 19999.99, \"points\": 240 },\n          { \"min\": 20000, \"max\": 999999999, \"points\": 420 }\n        ]\n      }\n    ],\n    \"decisionThresholds\": { \"minimumScoreRequired\": 180, \"baseMultiplier\": 0.55 }\n  }\n}" },
                "url": "{{baseUrl}}/api/v1/credit-scoring/models/{{scoring_model_id}}"
              }
            },
            { "name": "Credit Scoring - delete model", "request": { "method": "DELETE", "url": "{{baseUrl}}/api/v1/credit-scoring/models/{{scoring_model_id}}" } },
            {
              "name": "Credit Scoring - evaluate credit decision",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": { "mode": "raw", "raw": "{\n  \"transactionId\": \"score-{{run_id}}\",\n  \"profileId\": \"{{happy_profile_id}}\",\n  \"partnerId\": \"{{partner_id}}\",\n  \"currency\": \"{{currency}}\",\n  \"loanProductId\": \"{{seeded_loan_product_id}}\",\n  \"features\": {\n    \"wallet_throughput_30d\": \"25000\",\n    \"has_active_default\": \"false\"\n  }\n}" },
                "url": "{{baseUrl}}/api/v1/credit-scoring/evaluate"
              }
            }
          ]
        },
        {
          "name": "Accounts module",
          "item": [
