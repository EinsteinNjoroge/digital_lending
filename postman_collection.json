          ]
        },
        {
          "name": "Loan product families module",
          "item": [
            {
              "name": "Loan Product Families - create family definition",
              "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const json = pm.response.json(); if (json.id) pm.collectionVariables.set('family_definition_id', json.id);"] } }],
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": { "mode": "raw", "raw": "{\n  \"familyCode\": \"{{family_code}}\",\n  \"displayName\": \"API Family {{run_id}}\",\n  \"disbursementHandlerToken\": \"internalWalletDisbursementHandler\",\n  \"accrualHandlerToken\": \"straightLineDailyAccrualHandler\",\n  \"repaymentHandlerToken\": \"fifoLedgerRepaymentSettlementHandler\",\n  \"delinquencyHandlerToken\": \"softCollectionsHandler\",\n  \"isActive\": true\n}" },
                "url": "{{baseUrl}}/api/v1/family-definitions"
              }
            },
            { "name": "Loan Product Families - get family definition by id", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/family-definitions/{{family_definition_id}}" } },
            { "name": "Loan Product Families - list all family definitions", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/family-definitions" } },
            {
              "name": "Loan Product Families - update family definition",
              "request": {
                "method": "PUT",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": { "mode": "raw", "raw": "{\n  \"familyCode\": \"{{family_code}}\",\n  \"displayName\": \"API Family Updated {{run_id}}\",\n  \"disbursementHandlerToken\": \"internalWalletDisbursementHandler\",\n  \"accrualHandlerToken\": \"straightLineDailyAccrualHandler\",\n  \"repaymentHandlerToken\": \"fifoLedgerRepaymentSettlementHandler\",\n  \"delinquencyHandlerToken\": \"softCollectionsHandler\",\n  \"isActive\": true\n}" },
                "url": "{{baseUrl}}/api/v1/family-definitions/{{family_definition_id}}"
              }
            },
            { "name": "Loan Product Families - delete family definition", "request": { "method": "DELETE", "url": "{{baseUrl}}/api/v1/family-definitions/{{family_definition_id}}" } }
          ]
        },
        {
          "name": "Loan products module",
          "item": [
            {
              "name": "Loan Products - create loan product",
              "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const json = pm.response.json(); if (json.id) pm.collectionVariables.set('product_id', json.id);"] } }],
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "X-Modified-By", "value": "{{actor_email}}" }
                ],
                "body": { "mode": "raw", "raw": "{\n  \"productCode\": \"{{product_code}}\",\n  \"name\": \"API Product {{run_id}}\",\n  \"familyDefinitionId\": \"{{family_definition_id}}\",\n  \"partnerId\": \"{{partner_id}}\",\n  \"currency\": \"{{currency}}\",\n  \"isActive\": true,\n  \"parameters\": {\n    \"interest_rate_daily\": \"0.0015\",\n    \"max_tenor_days\": \"30\"\n  },\n  \"documentMatrices\": {\n    \"UNDERWRITING_CHECKLIST\": {\n      \"minimum_wallet_age_months\": 6,\n      \"require_identity_verification\": true\n    }\n  }\n}" },
                "url": "{{baseUrl}}/api/v1/loan-products"
              }
            },
